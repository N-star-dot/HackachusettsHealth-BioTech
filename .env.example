# Copy to .env and fill in. All keys are OPTIONAL — the app runs keyless at lower rate limits.
OPENALEX_API_KEY=
NCBI_API_KEY=

# LLM for the Designer agent (stage 2). Leave blank to use the deterministic mock designer.
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Polite-pool contact email for OpenAlex / NCBI (recommended, not required)
CONTACT_EMAIL=

# Database location
DATABASE_URL=database/app.db
