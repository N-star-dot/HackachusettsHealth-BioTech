{
  "name": "lab-planner-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/schema.d.ts",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "motion": "14.6.0",
    "@tanstack/react-query": "5.104.5",
    "zustand": "5.0.16",
    "zod": "4.6.7",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-array": "3.2.4",
    "d3-interpolate": "3.0.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slider": "1.6.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "~6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/d3-scale": "4.0.8",
    "@types/d3-shape": "3.1.6",
    "@types/d3-array": "3.2.1",
    "@types/d3-interpolate": "3.0.4",
    "openapi-typescript": "7.13.0",
    "vitest": "5.0.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1",
    "fast-check": "4.10.2",
    "@playwright/test": "1.64.1",
    "jsdom": "27.0.0"
  }
